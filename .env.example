# LLM for the Root cause and Report agents. Without a key the pipeline still runs:
# root causes come straight from the RCA documents and the report uses templated
# text, and both say so.
# LLM_PROVIDER=huggingface   (free tier has no credit; see README)
# Read token from https://huggingface.co/settings/tokens
HF_TOKEN=
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# REPORT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Active provider: OpenRouter (free model). Create a key at https://openrouter.ai/keys
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
LLM_MODEL=qwen2.5:7b

# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # or BAAI/bge-m3

# yolo = trained model; manifest = replay labels from samples/manifest.json (demo on synthetic renders)
# INSPECTION_MODE=yolo
# CONF_THRESHOLD=0.25
# ARUCO_MARKER_MM=20
