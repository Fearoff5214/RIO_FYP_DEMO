# Copy to .env and edit. Every line is optional: the value shown is the default.
# Full explanation of each setting: docs/DEPLOYMENT.md

# --- Language model (writes root-cause candidates; nothing else uses it) --------------------
# LLM_PROVIDER=ollama          # ollama | none  (none = causes are read straight from the KB text)
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434

# --- Detection ------------------------------------------------------------------------------
# YOLO_WEIGHTS=models/best.pt
# CONF_THRESHOLD=0.25          # detections below this are dropped
# LABEL_REVIEW_CONF=0.85       # detections below this go to the label-review gate
# SAM_ENABLED=1
# SAM_WEIGHTS=models/sam/mobile_sam.pt   # sam_b.pt = full SAM-B (downloads ~375 MB)
# ANOMALY_ENABLED=1
# BLUR_MIN=20                  # image-quality limits (variance of Laplacian, saturated-pixel share)
# GLARE_MAX=0.15

# --- Camera (phone through Iriun Webcam) ----------------------------------------------------
# CAMERA_DEFAULT_DEVICE=1      # index shown by "Find cameras" in the UI
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720

# --- Plant systems: empty = disabled ---------------------------------------------------------
# MES_URL=
# QMS_URL=
# ERP_URL=
# NOTIFY_URL=
# INTEGRATION_TOKEN=           # sent as "Authorization: Bearer <token>"
# INTEGRATION_ATTEMPTS=4

# --- Learning --------------------------------------------------------------------------------
# AUTO_RETRAIN=0               # 1 = retrain in the background once enough corrections exist
# RETRAIN_MIN_LABELS=20
# RECAL_MIN_SAMPLES=10

# --- Storage ----------------------------------------------------------------------------------
# DATA_DIR=runs/data           # database, uploads, reports, checkpoints
# PARTS_DIR=data/parts
# KB_SEED_DIR=data/kb_seed
