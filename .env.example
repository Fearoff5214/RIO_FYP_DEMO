# ── Novaliseo Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values for non-mock deployments.

# App mode: mock | real
NOVALISEO_MODE=mock

# Database (defaults to SQLite in development; use Postgres for production)
DATABASE_URL=sqlite:///./novaliseo_dev.db
# DATABASE_URL=postgresql+asyncpg://novaliseo:novaliseo@localhost:5432/novaliseo

# LLM providers (only needed when NOVALISEO_MODE=real or prediction.llm.provider != fake)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Object storage (MinIO / S3)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=novaliseo

# Redis (for Celery/Arq workers)
REDIS_URL=redis://localhost:6379/0

# JWT authentication
JWT_SECRET_KEY=change-this-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@novaliseo.com

# External integrations (mocks used when URLs are empty)
MES_URL=
QMS_URL=
ERP_URL=

# Kaggle (for re-running NEU-DET dataset download)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
