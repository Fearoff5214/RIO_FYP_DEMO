# ── Novaliseo Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values for non-mock deployments.

# App mode: mock | real
NOVALISEO_MODE=mock

# Database (defaults to SQLite in development; use Postgres for production)
DATABASE_URL=sqlite:///./novaliseo_dev.db
# DATABASE_URL=postgresql+asyncpg://novaliseo:novaliseo@localhost:5432/novaliseo

# LLM providers (only needed when NOVALISEO_MODE=real or prediction.llm.provider != fake)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini (Google AI Studio key from https://aistudio.google.com/apikey) - enables AI root cause analysis.
# With a key set, the LLM provider is chosen automatically (prediction.llm.provider: auto).
GEMINI_API_KEY=
# Model used for root cause analysis; must be a model your key can call (see scripts/check_gemini.py).
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried if the primary model is unavailable, rate-limited, or returns unusable output.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Force a provider: auto | gemini | anthropic | openai | fake   (empty = value from config/default.yaml)
NOVALISEO_LLM_PROVIDER=

# Object storage (MinIO / S3)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=novaliseo

# Redis (for Celery/Arq workers)
REDIS_URL=redis://localhost:6379/0

# JWT authentication
JWT_SECRET_KEY=change-this-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@novaliseo.com

# External integrations (mocks used when URLs are empty)
MES_URL=
QMS_URL=
ERP_URL=

# Kaggle (for re-running NEU-DET dataset download)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
